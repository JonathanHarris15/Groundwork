{
  "name": "groundwork",
  "private": true,
  "version": "0.2.1",
  "description": "A learning agent that plans from first principles, calibrates what you know with quizzes, and remembers it on your Groundwork account.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/obsidian-plugin",
    "packages/cli",
    "packages/server"
  ],
  "scripts": {
    "build": "npm run build -w packages/obsidian-plugin",
    "build:all": "npm run build && npm run build -w packages/cli && npm run build -w packages/server",
    "dev:plugin": "npm run dev -w packages/obsidian-plugin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint-obsidian.mjs",
    "test": "npm run build -w packages/server && vitest run",
    "test:website": "playwright test",
    "test:obsidian-appimage": "node scripts/obsidian-plugin-e2e.mjs",
    "groundwork": "node packages/cli/dist/groundwork.js",
    "server": "npm run start -w packages/server"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^26.1.0",
    "pyodide": "0.29.5",
    "stylelint": "^17.16.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.2"
  }
}
